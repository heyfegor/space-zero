# Space Zero — environment (copy to .env.local and fill in). Never commit .env*.

# Model provider selector for the getModel() factory.
# "anthropic" (default, no AWS) | "openai" (fallback) | "bedrock" (later, needs AWS)
# | "google" (temporary Gemini provider, needs GEMINI_API_KEY)
MODEL_PROVIDER=anthropic

# Anthropic direct API (development + demo default). Do NOT use AgentRouter.
ANTHROPIC_API_KEY=

# Model + generation config (optional; sensible defaults applied if unset).
# NOTE: MODEL_ID is provider-specific. The Anthropic default is claude-sonnet-4-6;
# for Gemini set a Gemini id (the google branch defaults to gemini-3.6-flash and
# never falls back to the Anthropic id).
MODEL_ID=claude-sonnet-4-6
MODEL_MAX_TOKENS=1024

# OpenAI fallback (only if MODEL_PROVIDER=openai)
# OPENAI_API_KEY=

# Google Gemini (temporary provider; only if MODEL_PROVIDER=google). Uses the
# already-installed @google/genai package. The google branch defaults to
# gemini-3.6-flash — set MODEL_ID=gemini-3.6-flash to be explicit.
# MODEL_PROVIDER=google
# GEMINI_API_KEY=
# MODEL_ID=gemini-3.6-flash

# Bedrock (only if MODEL_PROVIDER=bedrock; requires AWS credentials + model access)
# AWS_REGION=us-east-1

# Supabase persistence (server-side only).
# When both are set, the trip API uses Supabase; otherwise it falls back to an
# in-memory store for local dev. Run supabase/migrations/0001_init.sql first.
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security and MUST NEVER be sent to
# the browser — do not prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Duffel (server-side flight search AND real booking). When absent, flight search
# returns an honest "provider unavailable" state instead of fabricating flights,
# and execute_booking refuses (PROVIDER_UNCONFIGURED) rather than faking an order.
# Use a Duffel TEST-mode key for development — real orders settle from the Duffel
# balance; no third-party payment provider is involved.
DUFFEL_API_KEY=
# Optional Duffel API version header (defaults to v2).
# DUFFEL_API_VERSION=v2

# Flight-status provider (server-side flight monitoring / disruption detection).
# When absent, monitoring returns an honest "unavailable" state instead of
# fabricating a flight status — the backend never claims a flight is fine when it
# cannot see it. The provider is abstracted behind FlightStatusProvider, so this
# can be swapped for another tracker later. Current implementation: FlightAware
# AeroAPI (https://www.flightaware.com/aeroapi/).
FLIGHTAWARE_API_KEY=

# Airwallex (server-side, behind the funding/payment boundary). SANDBOX only.
# When configured, the provider authenticates AND creates a real sandbox PAYMENT
# INTENT to back funding and authorized recovery charges (the money-movement
# boundary is src/server/payments/payment-service.ts). It never fabricates a
# settled charge: a fresh intent is reported PENDING (capture needs a confirmed
# payment method, deliberately out of scope), and only a provider-reported
# SUCCEEDED unlocks a booking/funding/resolution. Every charge is gated by the
# deterministic authority + funding checks first and is idempotency-protected, so
# a retry never double-charges. When credentials are absent the funding/recovery
# layers keep the existing demo behavior rather than pretending a provider exists.
# Base URL:
#   sandbox    = https://api.sandbox.airwallex.com   (default when unset)
#   production = https://api.airwallex.com
# Auth: POST /api/v1/authentication/login with x-client-id + x-api-key headers.
# Payment: POST /api/v1/pa/payment_intents/create (request_id = idempotency key).
# Verify: node --env-file=.env.local --import tsx scripts/verify-airwallex.ts
AIRWALLEX_BASE_URL=https://api.sandbox.airwallex.com
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
