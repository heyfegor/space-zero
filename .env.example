# Space Zero — environment (copy to .env.local and fill in). Never commit .env*.

# Model provider selector for the getModel() factory.
# "anthropic" (default, no AWS) | "openai" (fallback) | "bedrock" (later, needs AWS)
MODEL_PROVIDER=anthropic

# Anthropic direct API (development + demo default). Do NOT use AgentRouter.
ANTHROPIC_API_KEY=

# Model + generation config (optional; sensible defaults applied if unset)
MODEL_ID=claude-sonnet-4-6
MODEL_MAX_TOKENS=1024

# OpenAI fallback (only if MODEL_PROVIDER=openai)
# OPENAI_API_KEY=

# Bedrock (only if MODEL_PROVIDER=bedrock; requires AWS credentials + model access)
# AWS_REGION=us-east-1

# Supabase persistence (server-side only).
# When both are set, the trip API uses Supabase; otherwise it falls back to an
# in-memory store for local dev. Run supabase/migrations/0001_init.sql first.
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security and MUST NEVER be sent to
# the browser — do not prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Duffel (server-side flight search AND real booking). When absent, flight search
# returns an honest "provider unavailable" state instead of fabricating flights,
# and execute_booking refuses (PROVIDER_UNCONFIGURED) rather than faking an order.
# Use a Duffel TEST-mode key for development — real orders settle from the Duffel
# balance; no third-party payment provider is involved.
DUFFEL_API_KEY=
# Optional Duffel API version header (defaults to v2).
# DUFFEL_API_VERSION=v2
